{
  "name": "slide-atlas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "An evidence-first design ontology and presentation operations workbench.",
  "scripts": {
    "predev": "node scripts/setup-fonts.mjs",
    "dev": "next dev --hostname 0.0.0.0",
    "prebuild": "node scripts/setup-fonts.mjs",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:check": "node scripts/check-docs.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "eval": "tsx scripts/evaluate.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "check": "npm run docs:check && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@next/env": "16.3.3",
    "fflate": "^0.8.3",
    "lucide-react": "^0.577.0",
    "next": "16.3.3",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.3",
    "pretendard": "^1.3.9",
    "prettier": "3.9.6",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": "24.x"
  }
}
