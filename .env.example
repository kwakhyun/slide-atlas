# No key or database is required for the local, deterministic demo.
# With no DATABASE_URL, an embedded PostgreSQL database is saved in .data/.
DATABASE_URL=
# Optional; real AI is disabled unless explicitly enabled by the operator.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_ENABLED=false
# Required to unlock billable AI on a public deployment. Never expose as NEXT_PUBLIC_*.
AI_ACCESS_CODE=
AI_DAILY_REQUEST_LIMIT=30
# Canonical public origin, e.g. https://slide-atlas.vercel.app
APP_ORIGIN=http://localhost:3000
