# 로컬 규칙 기반 데모는 API 키나 외부 DB 없이 실행하실 수 있습니다.
# DATABASE_URL을 비워두면 PGlite 데이터를 .data/에 저장합니다.
DATABASE_URL=
# 실제 AI 호출은 선택 사항이며, 운영자가 활성화하기 전까지 사용하지 않습니다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_ENABLED=false
# 공개 배포에서 유료 AI 호출을 허용하려면 초대 코드가 필요합니다.
# API 키와 초대 코드를 NEXT_PUBLIC_* 변수로 노출하지 마세요.
AI_ACCESS_CODE=
AI_DAILY_REQUEST_LIMIT=30
# 로컬 개발용 주소입니다. 공개 배포에서는 실제 서비스 출처로 설정해 주세요.
# 예: https://slide-atlas-mu.vercel.app
APP_ORIGIN=http://localhost:3000
